# OpsBrain environment variables
# Copy to .env and fill in real values — never commit .env to git

# ── Required ──────────────────────────────────────────────────────────────────
# Free tier: create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opsbrain
POSTGRES_USER=opsbrain

# ── Gemini model config (defaults shown; free tier via aistudio.google.com) ───
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_CHAT_MODEL=gemini-3.6-flash

# ── RAG tuning ────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ── Kafka (Stage 2) ───────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── AWS (Stage 3 — Terraform + EKS) ──────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=

# ── GitHub Actions secrets (set in repo settings, not here) ──────────────────
# ARGOCD_SERVER=https://argocd.your-domain.com
# ARGOCD_TOKEN=
